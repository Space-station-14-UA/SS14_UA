execution-verb-name = Стратити
execution-verb-message = Використати свою зброю, щоб стратити когось.

# All the below localisation strings have access to the following variables
# attacker (the person committing the execution)
# victim (the person being executed)
# weapon (the weapon used for the execution)

execution-popup-melee-initial-internal = Ви підносите {$weapon} до горла {$victim}.
execution-popup-melee-initial-external = { CAPITALIZE($attacker) } підносять {POSS-ADJ($attacker)} {$weapon} до горла {$victim}.
execution-popup-melee-complete-internal = Ви перерізали горло {$victim}!
execution-popup-melee-complete-external = { CAPITALIZE($attacker) } перерізали горло {$victim}!

execution-popup-self-initial-internal = Ви підносите {$weapon} до свого горла.
execution-popup-self-initial-external = { CAPITALIZE($attacker) } підносять {POSS-ADJ($attacker)} {$weapon} до свого горла.
execution-popup-self-complete-internal = Ви перерізали своє горло!
execution-popup-self-complete-external = { CAPITALIZE($attacker) } перерізали своє горло!
