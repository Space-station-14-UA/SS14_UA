<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               Title="RTS Control Panel"
               Resizable="False"
               MinWidth="180"
               MinHeight="100">
    <BoxContainer Orientation="Vertical" Margin="4" SeparationOverride="4">
        <Label Name="SelectionCountLabel" Text="Units Selected: 0" HorizontalAlignment="Center" />
        <GridContainer Columns="3" HorizontalAlignment="Center">
            <Button Name="MoveButton" Text="Move" MinWidth="60" />
            <Button Name="AttackMoveButton" Text="A-Move" MinWidth="60" />
            <Button Name="AttackTargetButton" Text="Attack" MinWidth="60" />
        </GridContainer>
        <Button Name="HoldButton" Text="Hold Position" HorizontalAlignment="Stretch" />
        <Button Name="StopButton" Text="Stop (Clear Orders)" HorizontalAlignment="Stretch" />
    </BoxContainer>
</DefaultWindow>
